# See http://help.github.com/ignore-files/ for more about ignoring files.


# Node
node_modules

# Variables d'environnement — ne jamais versionner
.env

# Superpowers subagent-driven-development scratch workspace (review packages)
/.superpowers/

# Worktrees isolés (créés par la skill using-git-worktrees)
/.worktrees/

# Refonte IPES — sorties générées (rapports/backups), jamais versionnées
/scripts/refonte_ipes/reports/*
!/scripts/refonte_ipes/reports/.gitkeep
/scripts/refonte_ipes/backups/*
!/scripts/refonte_ipes/backups/.gitkeep
